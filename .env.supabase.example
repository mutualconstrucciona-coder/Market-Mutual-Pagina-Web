# Configurar en Netlify y en .env.local de desarrollo. Nunca subir los valores reales a GitHub.
# Proyecto EXCLUSIVO Market Mutual. No usar credenciales de Bot Afiliados.
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Claves nuevas recomendadas. Ambas se leen exclusivamente en el servidor.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Compatibilidad transitoria con claves legacy. No configurar si ya se usan las nuevas.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca anteponer NEXT_PUBLIC_ a esta variable.
SUPABASE_SERVICE_ROLE_KEY=

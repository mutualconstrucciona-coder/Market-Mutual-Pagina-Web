# Configurar en Netlify y en .env.local de desarrollo. Nunca subir los valores reales a GitHub.
# Proyecto EXCLUSIVO Market Mutual. No usar credenciales de Bot Afiliados.
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Clave pública anon o sb_publishable_*, usada sólo por el servidor de login.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de backend: preferir sb_secret_*; también admite legacy service_role.
# Nunca anteponer NEXT_PUBLIC_ a esta variable.
SUPABASE_SERVICE_ROLE_KEY=
